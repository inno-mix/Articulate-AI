# Articulate AI API — local development settings.
# Copy to .env (make setup does this). Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://articulate:articulate@localhost:5432/articulate
TEST_DATABASE_URL=postgresql+asyncpg://articulate:articulate@localhost:5432/articulate_test
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000

# local_single_user until Phase 7 (accounts)
AUTH_MODE=local_single_user

# ollama | fake   (user_credentials arrives in Phase 9)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Development-only: your own key for the eval reference model (make eval-cloud). Never used by
# the running app; rejected outright when APP_ENV=production (ADR-0015). Set at most one.
# EVAL_ANTHROPIC_API_KEY=
# EVAL_OPENAI_API_KEY=
# EVAL_GOOGLE_API_KEY=

# Phase 3+ (voice practice): your own Deepgram key. Usage costs money — tell the owner before
# make test-live. Model choice decided by the Phase 3 spike (ADR-0013).
# DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
